  sentAt      DateTime @default(now())
  channel     String   @default("INBOX") @db.VarChar(32)
  status      String   @default("SENT") @db.VarChar(32)

  @@unique([tenantId, dedupKey])
  @@index([tenantId, entityType, entityId])
  @@map("studio_reminder_logs")
}

model StudioBackupLog {
  id                         String    @id @default(uuid())
  tenantId                   String
  tenant                     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  backupIdentifier           String    @db.VarChar(128)
  timestamp                  DateTime  @default(now())
  scope                      String    @db.VarChar(64) // FULL, DATABASE_ONLY, ATTACHMENTS_ONLY
  sizeBytes                  BigInt?
  checksum                   String?   @db.VarChar(128)
  status                     String    @default("SUCCESS") @db.VarChar(32) // SUCCESS, FAILED
  retentionDays              Int       @default(30)
  verifiedRestoreAt          DateTime?
  verifiedRestoreDurationMs  Int?
  verifiedRestoreNotes       String?   @db.Text
  notes                      String?   @db.Text
  createdAt                  DateTime  @default(now())

  @@index([tenantId, timestamp, status])
  @@map("studio_backup_logs")
}

