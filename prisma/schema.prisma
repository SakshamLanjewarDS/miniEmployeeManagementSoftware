// Prisma Schema for 100% DESIGN Studio — Multi-Tenant Architecture Project Management Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. TENANCY & GLOBAL IDENTITY
// ==========================================

enum TenantLifecycleState {
  PROVISIONING
  ACTIVE
  SUSPENDED
  DELETION_PENDING
  DELETED
}

enum TenantRole {
  OWNER
  ADMIN
  PROJECT_MANAGER
  EMPLOYEE
}

enum UserAccountState {
  ACTIVE
  DISABLED
}

model Tenant {
  id             String               @id @default(uuid())
  slug           String               @unique @db.VarChar(64)
  name           String               @db.VarChar(191)
  timezone       String               @default("Asia/Kolkata") @db.VarChar(64)
  currency       String               @default("INR") @db.VarChar(10)
  branding       Json?
  lifecycleState TenantLifecycleState @default(ACTIVE)
  settings       Json?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  memberships       TenantMembership[]
  employees         Employee[]
  invitations       TenantInvitation[]
  clients           Client[]
  projects          Project[]
  consultants       Consultant[]
  contractors       Contractor[]
  tasks             Task[]
  sites             Site[]
  siteVisits        SiteVisit[]
  documents         Document[]
  privateFiles      PrivateFile[]
  budgets           Budget[]
  feeMilestones     FeeMilestone[]
  expenses          Expense[]
  notifications     Notification[]
  outbox            NotificationOutbox[]
  auditEvents       AuditEvent[]
  subscriptions     Subscription[]
  tenantExports     TenantExport[]
  deletionRequests  DeletionRequest[]
  projectTemplates  ProjectTemplate[]
  projectChangeRequests ProjectChangeRequest[]
  projectMilestones ProjectMilestone[]
  profileChangeRequests ProfileChangeRequest[]

  // --- Project 2 Canonical Integrations ---
  leavePolicy           StudioLeavePolicy?
  leaveRequests         StudioLeaveRequest[]
  attendanceRecords     StudioAttendanceRecord[]
  employeeCompensations StudioEmployeeCompensation[]
  payrollPeriods        StudioPayrollPeriod[]
  payrollRecords        StudioPayrollRecord[]
  payrollAdjustments    StudioPayrollAdjustment[]
  advanceLoans          StudioAdvanceLoan[]
  executiveTasks        ExecutiveTask[]
  executiveTaskAssignments ExecutiveTaskAssignment[]
  executiveTaskComments ExecutiveTaskComment[]
  executiveTaskAttachments ExecutiveTaskAttachment[]
  executiveTaskActivities ExecutiveTaskActivity[]
  studioMeetings        StudioMeeting[]
  studioMeetingActionItems StudioMeetingActionItem[]
  studioVendors         StudioVendor[]
  studioEmailOutbox     StudioEmailOutbox[]
  studioExecutiveNotifications StudioExecutiveNotification[]
  studioImportBatches   StudioImportBatch[]
  studioSyncConfigs     StudioSyncConfig[]
  studioSyncRuns        StudioSyncRun[]

  // --- Studio Improvements Programme ---
  leaveCancellationRequests StudioLeaveCancellationRequest[]
  siteIssues               StudioSiteIssue[]
  reminderConfigs          StudioReminderConfig[]
  reminderLogs             StudioReminderLog[]
  backupLogs               StudioBackupLog[]
  devicePushSubscriptions  DevicePushSubscription[]

  @@map("tenants")
}

model User {
  id               String           @id @default(uuid())
  email            String           @unique @db.VarChar(191)
  passwordHash     String           @db.VarChar(255)
  fullName         String           @db.VarChar(191)
  accountState     UserAccountState @default(ACTIVE)
  mfaSecret        String?          @db.VarChar(255)
  mfaEnabled       Boolean          @default(false)
  mfaRecoveryCodes Json?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  memberships TenantMembership[]
  sessions    Session[]

  @@map("users")
}

model TenantMembership {
  id               String     @id @default(uuid())
  tenantId         String
  tenant           Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId           String
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role             TenantRole @default(EMPLOYEE)
  hasFinanceAccess Boolean    @default(false)
  isActive         Boolean    @default(true)
  joinedAt         DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  employee         Employee?
  projectMembers   ProjectMember[]
  architectedProjects Project[]   @relation("ProjectArchitect")
  managedProjects  Project[]        @relation("ProjectManager")
  coordinatedProjects Project[]     @relation("ProjectCoordinator")
  assignedTasks    Task[]           @relation("TaskAssignee")
  createdTasks     Task[]           @relation("TaskCreator")
  siteVisits       SiteVisit[]      @relation("VisitEmployee")
  reviewedVisits   SiteVisit[]      @relation("VisitReviewer")
  notifications    Notification[]   @relation("RecipientNotifications")
  assignedChecklistItems TaskChecklistItem[] @relation("ChecklistItemAssignee")
  reviewedTasks    Task[]           @relation("TaskReviewer")
  taskAssignments  TaskAssignment[]
  submittedTaskSubmissions TaskSubmission[] @relation("SubmissionSubmitter")
  reviewedTaskSubmissions  TaskSubmission[] @relation("SubmissionReviewer")
  requestedTaskExtensions  TaskExtensionRequest[] @relation("ExtensionRequester")
  decidedTaskExtensions    TaskExtensionRequest[] @relation("ExtensionDecider")
  taskClarifications       TaskClarification[]
  taskClarificationReplies TaskClarificationReply[]
  projectChangeRequests    ProjectChangeRequest[]   @relation("ChangeRequestRequester")
  decidedChangeRequests    ProjectChangeRequest[]   @relation("ChangeRequestDecider")
  profileChangeRequests    ProfileChangeRequest[]
  submittedExpenses        Expense[]                @relation("ExpenseSubmitter")

  // --- Project 2 Canonical Integrations ---
  reviewedLeaves           StudioLeaveRequest[]     @relation("ReviewedLeave")
  cancelledLeaves          StudioLeaveRequest[]     @relation("CancelledLeave")
  correctedAttendance      StudioAttendanceRecord[] @relation("CorrectedAttendance")
  approvedPayrolls         StudioPayrollPeriod[]    @relation("PayrollApprover")
  calculatedPayrolls       StudioPayrollRecord[]    @relation("PayrollCalculator")
  authorizedAdjustments    StudioPayrollAdjustment[] @relation("AuthorizedAdjustment")
  approvedLoans            StudioAdvanceLoan[]      @relation("ApprovedLoan")
  createdExecutiveTasks    ExecutiveTask[]          @relation("ExecutiveTaskCreator")
  assignedExecutiveTasks   ExecutiveTaskAssignment[] @relation("ExecutiveTaskAssignee")
  authoredTaskComments     ExecutiveTaskComment[]   @relation("AuthoredTaskComment")
  uploadedTaskAttachments  ExecutiveTaskAttachment[] @relation("UploadedTaskAttachment")
  loggedTaskActivities     ExecutiveTaskActivity[]  @relation("LoggedTaskActivity")
  createdMeetings          StudioMeeting[]          @relation("CreatedMeeting")
  assignedActionItems      StudioMeetingActionItem[] @relation("AssignedActionItem")
  executiveNotifications   StudioExecutiveNotification[] @relation("ExecutiveNotificationRecipient")
  reviewedCancellations    StudioLeaveCancellationRequest[] @relation("ReviewedCancellation")
  reportedSiteIssues       StudioSiteIssue[]                @relation("ReportedSiteIssue")
  verifiedSiteIssues       StudioSiteIssue[]                @relation("VerifiedSiteIssue")
  devicePushSubscriptions  DevicePushSubscription[]

  @@unique([tenantId, userId])
  @@index([tenantId, role])
  @@map("tenant_memberships")
}

model Employee {
  id                 String           @id @default(uuid())
  tenantId           String
  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membershipId       String           @unique
  membership         TenantMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  employeeId         String           @db.VarChar(64)
  phone              String?          @db.VarChar(100)
  department         String?          @db.VarChar(100)
  designation        String?          @db.VarChar(100)
  joinDate           DateTime?
  reportingManagerId String?
  employmentStatus   String?          @default("ACTIVE") @db.VarChar(32) // ACTIVE, ONBOARDING, OFFBOARDING, DEACTIVATED
  deactivatedAt      DateTime?
  deactivationReason String?          @db.Text
  offboardingHandover Json?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  profileChangeRequests ProfileChangeRequest[]

  // --- Project 2 Canonical Integrations ---
  leaveRequests         StudioLeaveRequest[]
  attendanceRecords     StudioAttendanceRecord[]
  compensations         StudioEmployeeCompensation[]
  payrollRecords        StudioPayrollRecord[]
  payrollAdjustments    StudioPayrollAdjustment[]
  advanceLoans          StudioAdvanceLoan[]

  // --- Studio Improvements Programme ---
  cancellationRequests  StudioLeaveCancellationRequest[]
  responsibleSiteIssues StudioSiteIssue[]                @relation("ResponsibleSiteIssue")

  @@unique([tenantId, employeeId])
  @@index([tenantId, employeeId])
  @@map("employees")
}

model Session {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token          String    @unique @db.VarChar(128)
  activeTenantId String?
  ipAddress      String?   @db.VarChar(64)
  userAgent      String?   @db.VarChar(255)
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([userId])
  @@index([token])
  @@map("sessions")
}

model TenantInvitation {
  id          String     @id @default(uuid())
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email       String     @db.VarChar(191)
  role        TenantRole @default(EMPLOYEE)
  token       String     @unique @db.VarChar(128)
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  status      String     @default("PENDING") @db.VarChar(32) // PENDING, ACCEPTED, EXPIRED, REVOKED
  revokedAt   DateTime?
  suggestedDepartment String? @db.VarChar(100)
  suggestedDesignation String? @db.VarChar(100)
  createdAt   DateTime   @default(now())

  @@index([tenantId, email])
  @@map("tenant_invitations")
}

// ==========================================
// 2. CLIENTS, CONSULTANTS, CONTRACTORS
// ==========================================

model Client {
  id        String    @id @default(uuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String    @db.VarChar(191)
  company   String?   @db.VarChar(191)
  email     String?   @db.VarChar(191)
  contact   String?   @db.VarChar(64)
  address   String?   @db.Text
  notes     String?   @db.Text
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  projects  Project[]

  @@index([tenantId, isActive])
  @@map("clients")
}

model Consultant {
  id          String              @id @default(uuid())
  tenantId    String
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String              @db.VarChar(191)
  email       String?             @db.VarChar(191)
  contact     String?             @db.VarChar(64)
  firmName    String?             @db.VarChar(191)
  firmAddress String?             @db.Text
  discipline  String              @db.VarChar(100) // Structural, MEP, HVAC, Landscape, Lighting, Acoustics
  notes       String?             @db.Text
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  projects    ProjectConsultant[]
  primaryProjects Project[]

  @@index([tenantId, isActive])
  @@map("consultants")
}

model Contractor {
  id        String              @id @default(uuid())
  tenantId  String
  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String              @db.VarChar(191)
  contact   String?             @db.VarChar(64)
  email     String?             @db.VarChar(191)
  firmName  String?             @db.VarChar(191)
  trade     String              @db.VarChar(100) // Civil / Masonry, Electrical, Carpentry & Joinery, Plumbing, Painting
  address   String?             @db.Text
  isActive  Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  projects  ProjectContractor[]
  primaryProjects Project[]

  @@index([tenantId, isActive])
  @@map("contractors")
}

// ==========================================
// 3. PROJECTS, PHASES, & EXTERNAL LINKS
// ==========================================

enum ProjectStatus {
  DRAFT
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
  ARCHIVED
}

model Project {
  id               String            @id @default(uuid())
  tenantId         String
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code             String            @db.VarChar(32) // Unique per tenant
  name             String            @db.VarChar(191)
  description      String?           @db.Text
  primaryClientId  String?
  primaryClient    Client?           @relation(fields: [primaryClientId], references: [id], onDelete: SetNull)
  projectType      String?           @db.VarChar(100)
  siteAddress      String?           @db.Text
  projectArchitectId String?
  projectArchitect   TenantMembership? @relation("ProjectArchitect", fields: [projectArchitectId], references: [id], onDelete: SetNull)
  projectManagerId String?
  projectManager   TenantMembership? @relation("ProjectManager", fields: [projectManagerId], references: [id], onDelete: SetNull)
  projectCoordinatorId String?
  projectCoordinator   TenantMembership? @relation("ProjectCoordinator", fields: [projectCoordinatorId], references: [id], onDelete: SetNull)
  siteCity         String?           @db.VarChar(100)
  googleMapLocation String?          @db.Text
  contractorId     String?
  contractor       Contractor?       @relation(fields: [contractorId], references: [id], onDelete: SetNull)
  consultantId     String?
  consultant       Consultant?       @relation(fields: [consultantId], references: [id], onDelete: SetNull)
  plotArea         String?           @db.VarChar(100)
  constructionArea String?           @db.VarChar(100)
  currentPhase     String?           @db.VarChar(100)
  status           ProjectStatus     @default(ACTIVE)
  startDate        DateTime?
  targetDate       DateTime?
  budget           Decimal?          @db.Decimal(15, 2)
  currency         String            @default("INR") @db.VarChar(10)
  isArchived       Boolean           @default(false)
  brief            String?           @db.Text
  scopeItems       Json?
  exclusions       Json?
  acceptanceCriteria String?         @db.Text
  requiredClientInputs Json?
  holdReason       String?           @db.Text
  heldAt           DateTime?
  heldById         String?
  completionChecklist Json?
  completedById    String?
  reopenReason     String?           @db.Text
  reopenedAt       DateTime?
  reopenedById     String?
  cancellationReason String?         @db.Text
  cancelledAt      DateTime?
  cancelledById    String?
  appliedTemplateId String?          @db.VarChar(64)
  templateVersion   Int?
  templateAppliedAt DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  members          ProjectMember[]
  phases           ProjectPhase[]
  consultants      ProjectConsultant[]
  contractors      ProjectContractor[]
  tasks            Task[]
  sites            Site[]
  siteVisits       SiteVisit[]
  documents        Document[]
  budgets          Budget[]
  feeMilestones    FeeMilestone[]
  expenses         Expense[]
  approvalRequests ApprovalRequest[]
  changeRequests   ProjectChangeRequest[]
  milestones       ProjectMilestone[]

  // --- Project 2 Canonical Integrations ---
  executiveTasks   ExecutiveTask[]
  studioMeetings   StudioMeeting[]
  siteIssues       StudioSiteIssue[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, projectArchitectId])
  @@index([tenantId, projectManagerId])
  @@index([tenantId, projectCoordinatorId])
  @@index([tenantId, contractorId])
  @@index([tenantId, consultantId])
  @@map("projects")
}

model ProjectMember {
  id           String           @id @default(uuid())
  tenantId     String
  projectId    String
  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  membershipId String
  membership   TenantMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  projectRole  String           @default("Team Member") @db.VarChar(100)
  createdAt    DateTime         @default(now())

  @@unique([projectId, membershipId])
  @@index([tenantId, projectId])
  @@map("project_members")
}

enum PhaseStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  DELAYED
}

model ProjectPhase {
  id               String      @id @default(uuid())
  tenantId         String
  projectId        String
  project          Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phaseName        String      @db.VarChar(100)
  sortOrder        Int
  plannedStartDate DateTime?
  plannedEndDate   DateTime?
  actualStartDate  DateTime?
  actualEndDate    DateTime?
  status           PhaseStatus @default(NOT_STARTED)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  tasks            Task[]
  milestones       ProjectMilestone[]

  @@index([tenantId, projectId, sortOrder])
  @@map("project_phases")
}

model ProjectConsultant {
  id               String     @id @default(uuid())
  tenantId         String
  projectId        String
  project          Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  consultantId     String
  consultant       Consultant @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  scope            String?    @db.Text
  engagementStatus String     @default("Engaged") @db.VarChar(64)
  createdAt        DateTime   @default(now())

  @@unique([projectId, consultantId])
  @@index([tenantId, projectId])
  @@map("project_consultants")
}

model ProjectContractor {
  id               String       @id @default(uuid())
  tenantId         String
  projectId        String
  project          Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contractorId     String
  contractor       Contractor   @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  scope            String?      @db.Text
  engagementStatus String       @default("Active") @db.VarChar(64)
  createdAt        DateTime     @default(now())

  quotations       Quotation[]

  @@unique([projectId, contractorId])
  @@index([tenantId, projectId])
  @@map("project_contractors")
}

enum QuotationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  SUPERSEDED
}

model Quotation {
  id                  String            @id @default(uuid())
  tenantId            String
  projectContractorId String
  projectContractor   ProjectContractor @relation(fields: [projectContractorId], references: [id], onDelete: Cascade)
  quotationNumber     String            @db.VarChar(64)
  revision            Int               @default(1)
  amount              Decimal           @db.Decimal(15, 2)
  currency            String            @default("INR") @db.VarChar(10)
  submittedDate       DateTime
  validityDate        DateTime?
  status              QuotationStatus   @default(SUBMITTED)
  privateFileId       String?
  notes               String?           @db.Text
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([tenantId, projectContractorId])
  @@map("quotations")
}

// ==========================================
// 4. TASKS, CHECKLISTS, COMMENTS, WORKFLOW
// ==========================================

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskWorkflowStatus {
  NOT_STARTED
  TODO
  STARTED
  ONGOING
  IN_PROGRESS
  CHECKING
  IN_REVIEW
  COMPLETED
  BLOCKED
  CANCELLED
}

model Task {
  id                String             @id @default(uuid())
  tenantId          String
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId         String
  project           Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phaseId           String?
  phase             ProjectPhase?      @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  title             String             @db.VarChar(255)
  description       String?            @db.Text
  assigneeId        String?
  assignee          TenantMembership?  @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assignedMemberIds Json?
  creatorId         String
  creator           TenantMembership   @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  priority          TaskPriority       @default(MEDIUM)
  status            TaskWorkflowStatus @default(NOT_STARTED)
  startDate         DateTime?
  dueDate           DateTime?
  estimatedHours    Decimal?           @db.Decimal(6, 2)
  completionDate    DateTime?
  blockerReason  String?            @db.Text
  reviewerId        String?
  reviewer          TenantMembership?  @relation("TaskReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  acceptanceCriteria String?           @db.Text
  referenceFiles    Json?
  parentTaskId   String?
  scopeChangeId  String?            @db.VarChar(64)
  version        Int                @default(1)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  checklistItems   TaskChecklistItem[]
  comments         TaskComment[]
  activityHistory  TaskActivityHistory[]
  siteVisits       SiteVisit[]
  documents        Document[]
  approvalRequests ApprovalRequest[]
  assignments      TaskAssignment[]
  submissions      TaskSubmission[]
  extensionRequests TaskExtensionRequest[]
  clarifications   TaskClarification[]

  @@index([tenantId, projectId, status])
  @@index([tenantId, assigneeId, dueDate])
  @@index([tenantId, reviewerId])
  @@map("tasks")
}

model TaskChecklistItem {
  id               String              @id @default(uuid())
  tenantId         String
  taskId           String
  task             Task                @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title            String              @db.VarChar(255)
  description      String?             @db.Text
  acceptanceCriteria String?           @db.Text
  isCompleted      Boolean             @default(false)
  sortOrder        Int                 @default(0)
  completedAt      DateTime?
  completedById    String?
  assignedMemberId String?
  assignedMember   TenantMembership?   @relation("ChecklistItemAssignee", fields: [assignedMemberId], references: [id], onDelete: SetNull)
  priority         TaskPriority        @default(MEDIUM)
  dueDate          DateTime?
  status           TaskWorkflowStatus  @default(NOT_STARTED)
  startedAt        DateTime?
  isBlocked        Boolean             @default(false)
  blockerReason    String?             @db.Text
  blockerDetails   Json?
  prerequisiteItemId String?
  prerequisiteItem TaskChecklistItem?  @relation("ItemDependencies", fields: [prerequisiteItemId], references: [id], onDelete: SetNull)
  dependentItems   TaskChecklistItem[] @relation("ItemDependencies")
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @default(now()) @updatedAt

  approvalRequests  ApprovalRequest[]
  extensionRequests TaskExtensionRequest[]
  clarifications    TaskClarification[]

  @@index([tenantId, taskId])
  @@index([tenantId, assignedMemberId])
  @@index([tenantId, prerequisiteItemId])
  @@map("task_checklist_items")
}

model TaskAssignment {
  id                  String           @id @default(uuid())
  tenantId            String
  taskId              String
  task                Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  membershipId        String
  membership          TenantMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  acknowledgedAt      DateTime?
  acknowledgedVersion Int?
  isCompleted         Boolean          @default(false)
  completedAt         DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@unique([taskId, membershipId])
  @@index([tenantId, membershipId])
  @@map("task_assignments")
}

model TaskSubmission {
  id               String            @id @default(uuid())
  tenantId         String
  taskId           String
  task             Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  submitterId      String
  submitter        TenantMembership  @relation("SubmissionSubmitter", fields: [submitterId], references: [id], onDelete: Cascade)
  reviewerId       String?
  reviewer         TenantMembership? @relation("SubmissionReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  version          Int               @default(1)
  summary          String            @db.Text
  checklistTaskIds Json
  criteriaSnapshot String?           @db.Text
  evidenceFiles    Json?
  evidenceLinks    Json?
  status           String            @default("PENDING")
  reviewFeedback   String?           @db.Text
  decidedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([tenantId, taskId, version])
  @@index([tenantId, submitterId, status])
  @@index([tenantId, reviewerId, status])
  @@map("task_submissions")
}

model TaskExtensionRequest {
  id              String            @id @default(uuid())
  tenantId        String
  taskId          String
  task            Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  checklistItemId String
  checklistItem   TaskChecklistItem @relation(fields: [checklistItemId], references: [id], onDelete: Cascade)
  requesterId     String
  requester       TenantMembership  @relation("ExtensionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  deciderId       String?
  decider         TenantMembership? @relation("ExtensionDecider", fields: [deciderId], references: [id], onDelete: SetNull)
  currentDueDate  DateTime?
  proposedDueDate DateTime
  reason          String            @db.Text
  status          String            @default("PENDING")
  decisionReason  String?           @db.Text
  decidedAt       DateTime?
  createdAt       DateTime          @default(now())

  @@index([tenantId, checklistItemId, status])
  @@index([tenantId, requesterId])
  @@map("task_extension_requests")
}

model TaskClarification {
  id              String                   @id @default(uuid())
  tenantId        String
  taskId          String
  task            Task                     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  checklistItemId String?
