# =======================================================
# 100% DESIGN Studio — Multi-Tenant SaaS Platform Configuration
# =======================================================

# Database Connection (MySQL 5.7+ / 8.0+)
DATABASE_URL="mysql://db_user:secure_password@localhost:3306/studio_os_db"

# Session Security Secret (Min 64 characters)
SESSION_SECRET="replace_with_a_64_character_cryptographically_secure_random_hex"

# Application Settings
NEXT_PUBLIC_APP_NAME="100% DESIGN Studio OS"
APP_DEFAULT_TIMEZONE="Asia/Kolkata"
APP_DEFAULT_CURRENCY="INR"
NODE_ENV="development"

# Private Storage Path (outside public folder)
STORAGE_LOCAL_ROOT="./storage/uploads"

# Transactional Email Outbox / SMTP (Optional Mock in Dev)
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="notifications@100percentdesign.in"

# Live Google Sheets 2-Way Sync Webhook (Optional)
GOOGLE_SHEETS_LEAVE_WEBHOOK_URL="https://script.google.com/macros/s/your_deployment_id/exec"

# Web Push Notifications (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY="replace_with_public_vapid_key"
VAPID_PRIVATE_KEY="replace_with_private_vapid_key"
VAPID_SUBJECT="mailto:notifications@100percentdesign.in"
